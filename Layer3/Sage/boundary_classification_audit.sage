#!/usr/bin/env sage
# ---------------------------------------------------------------------------
# SOURCE (primary): LA-8370-MS (1980) Eqs 105-112: (i gamma^j d_j + 1) psi = 0,
#   x^4 = gamma/a0 with gamma the mass density (a HALF-LINE x^4 >= 0);
#   Eq 109-111 Williams' 8x8 representation (two inequivalent 4x4 blocks).
#   u4 = dy4/dt = 0 is conservation of mass (Book Eq 1.36 / 10.6).
# Context: noflux_boundary_derivation.sage (S1: U(2) family, two chiral BCs,
#   zero mode), weak_chirality_u4.sage, su2_from_5d.sage (8x8 symmetry),
#   heavy_massaxis_partners.sage (continuum).  Ledger Q3, Q4, Q17.
# Supplementary Materials: step [S1], Sec. S4 (code index: Sec. S6).
# ---------------------------------------------------------------------------
#
# boundary_classification_audit.sage                   [A] (assertion-hardened)
#
# AUDIT OF S1.  J^4(0) = 0 admits a family of boundary conditions; the
# chiral conditions P_R psi(0) = 0 / P_L psi(0) = 0 are claimed to be the
# only Lorentz-invariant self-adjoint members, each with the stated zero
# modes.  Checked here:
#
#   [A] SELF-ADJOINT, not merely symmetric: deficiency indices (2,2) at any
#       transverse momentum; a 2-dim B-isotropic subspace is MAXIMAL (equal
#       to its B-orthogonal complement), so each member of the U(2) family
#       gives a self-adjoint H; a 1-dim isotropic subspace gives a
#       symmetric, non-self-adjoint one.
#   [B] EXHAUSTIVE (one 4x4 irrep): the associative algebra generated by the
#       4D Lorentz generators is M2 + M2 (dim 8) and contains P_L, P_R, so
#       the only invariant 2-dim subspaces are L and R.
#   [C] SPECTRUM for each allowed BC, constant M: all normalisable modes of
#       4D mass m with |m| < |M| found exactly.  One BC: exactly one bound
#       state, m = 0 (the zero mode).  The other: none.  |m| >= |M|:
#       continuum.
#   [D] MASS PROFILE: the half-line alone gives no zero mode (M = 0); the
#       zero mode needs int_0^oo exp(-2 int M) < oo.  M = const and M ~ x^4
#       both work; M -> c/x^4 works only for c > 1/2.  For M ~ x^4 the
#       massive partners are a DISCRETE tower m^2 = 4 mu n, not a continuum.
#   [E] WILLIAMS' 8x8: Lorentz + self-adjointness alone admit MORE than the
#       chiral pair -- a CP^1 family mixing the two blocks, besides four
#       block-pure members.  The internal symmetry (blockwise phases here;
#       su(2) in su2_from_5d [D]) removes the mixing family; the zero-mode
#       content of each surviving member is listed.
# ---------------------------------------------------------------------------

from sage.all import *

def check(cond, label):
    cond = bool(cond)
    print("  [%s] %s" % ("PASS" if cond else "FAIL", label))
    assert cond, "ASSERTION FAILED: " + label

print("=" * 74)
print("boundary_classification_audit.sage -- is the S1 classification complete?")
print("=" * 74)

K = CyclotomicField(4); i_ = K.gen()
I2, Z2, Z4 = identity_matrix(K, 2), zero_matrix(K, 2), zero_matrix(K, 4)
I4 = identity_matrix(K, 4)
s = [matrix(K, [[0, 1], [1, 0]]), matrix(K, [[0, -i_], [i_, 0]]),
     matrix(K, [[1, 0], [0, -1]])]
B = lambda a, b, c, d: block_matrix([[a, b], [c, d]], subdivide=False)
g = [B(I2, Z2, Z2, -I2)] + [B(Z2, si, -si, Z2) for si in s]
g5 = i_ * g[0] * g[1] * g[2] * g[3]
eta = [1, -1, -1, -1, -1]
H_ = lambda X: X.conjugate_transpose()

def clifford(GG):
    n = GG[0].nrows()
    return all(GG[j] * GG[k] + GG[k] * GG[j] == (2 * eta[j] if j == k else 0) * identity_matrix(K, n)
               for j in range(5) for k in range(5))

G = {kap: g + [i_ * kap * g5] for kap in (1, -1)}      # the two 4x4 irreps
check(all(clifford(G[k]) for k in G), "both 4x4 irreps (kappa = +-1) obey the 5D Clifford algebra")
PL, PR = (I4 - g5) / 2, (I4 + g5) / 2
al = [g[0] * G[1][k] for k in range(1, 5)]
a4 = al[3]                                              # boundary form B = alpha^4

def perp(Wb, Bf):
    """B-orthogonal complement of the column space of Wb."""
    return (H_(Wb) * Bf).right_kernel()

# ============================================================ [A]
print("\n[A] Self-adjoint, not merely symmetric")
R = PolynomialRing(K, 'p1,p2,p3,M,z'); p1, p2, p3, M, z = R.gens()
h = al[0] * p1 + al[1] * p2 + al[2] * p3 - M * g[0]     # H at fixed transverse p
Az = i_ * a4 * (z * I4 - h)                             # (H - z) psi = 0 <=> psi' = A psi
check(Az * Az == (p1**2 + p2**2 + p3**2 + M**2 - z**2) * identity_matrix(R, 4),
      "(H - z)psi = 0 is psi' = A psi with A^2 = (p^2 + M^2 - z^2) 1")
check(Az.trace() == 0, "tr A = 0")
print("    z = +-i: A^2 = (p^2 + M^2 + 1) 1 > 0, A diagonalisable with eigenvalues")
print("    +-sqrt(p^2+M^2+1), two each (trace 0): two decaying solutions each.")
print("    => deficiency indices (2, 2) at every p and M: self-adjoint extensions")
print("       exist and are parametrised by U(2) (von Neumann; imported).")
Lb = PL.column_space().basis_matrix().transpose()
Rb = PR.column_space().basis_matrix().transpose()
for nm, Wb in (("L", Lb), ("R", Rb)):
    Wp = perp(Wb, a4)
    check(Wp.dimension() == 2 and Wp == Wb.column_space(),
          "W = %s is MAXIMAL isotropic: W^perp_B = W (domain of H* = domain of H)" % nm)
ep = (a4 - I4).right_kernel().basis(); em = (a4 + I4).right_kernel().basis()
Ua = matrix(K, [[0, 1], [1, 0]])                        # a sample unitary E+ -> E-
WU = matrix(K, [ep[0] + (Ua[0, 0] * em[0] + Ua[1, 0] * em[1]),
                ep[1] + (Ua[0, 1] * em[0] + Ua[1, 1] * em[1])]).transpose()
check(H_(WU) * a4 * WU == 0 and perp(WU, a4) == WU.column_space(),
      "a graph-of-unitary member is maximal isotropic too (the U(2) family)")
W1 = matrix(K, [ep[0] + em[0]]).transpose()
check(H_(W1) * a4 * W1 == 0 and perp(W1, a4).dimension() == 3,
      "a 1-dim isotropic W: B vanishes but W^perp has dim 3 -- symmetric, NOT "
      "self-adjoint (mutation: isotropy alone is not enough)")

# ============================================================ [B]
print("\n[B] Exhaustive for one 4x4 irrep")
Sig = [(g[m] * g[n] - g[n] * g[m]) / 4 for m in range(4) for n in range(m + 1, 4)]
def algebra(gens):
    n = gens[0].nrows()
    span = matrix(K, [identity_matrix(K, n).list()]).row_space()
    while True:
        new = [X * matrix(K, n, n, list(v)) for X in gens for v in span.basis()]
        S2 = span + matrix(K, [m.list() for m in new]).row_space()
        if S2.dimension() == span.dimension():
            return span
        span = S2
Alg = algebra(Sig)
block = matrix(K, [(PL * matrix(K, 4, 4, list(e)) * PL + PR * matrix(K, 4, 4, list(e)) * PR).list()
                   for e in identity_matrix(K, 16).rows()]).row_space()
check(Alg.dimension() == 8 and Alg == block,
      "algebra generated by the Lorentz generators = M2(L) + M2(R) (dim 8)")
check(vector(K, PL.list()) in Alg and vector(K, PR.list()) in Alg,
      "it contains P_L and P_R")
print("    So an invariant W containing l + r (l in L, r in R, both != 0) contains")
print("    P_L(l+r) = l and P_R(l+r) = r and then all of L and R: W = C^4.  An")
print("    invariant 2-plane has no mixed vector, so W = L or W = R.")
check(H_(Lb) * a4 * Lb == 0 and H_(Rb) * a4 * Rb == 0,
      "both are isotropic: the Lorentz-invariant self-adjoint BCs are EXACTLY "
      "P_R psi(0) = 0 (W = L) and P_L psi(0) = 0 (W = R)")

# ============================================================ [C]
print("\n[C] Spectrum for each allowed BC, constant M (rest frame, 4D mass m)")
# psi = exp(-i m t) chi(y): (m g0 + i G4 d_y + M) chi = 0  ->  chi' = T chi,
# T = -i G4 (m g0 + M), T^2 = (M^2 - m^2) 1.  For |m| < |M| put k = sqrt(M^2 - m^2)
# > 0: chi normalisable iff chi(0) in ker(T + k), and the BC needs chi(0) in W.
S = PolynomialRing(K, 'm,k'); m, k = S.gens()
def bound_states(kap, Mv, Wb):
    T = -i_ * G[kap][4] * (m * g[0] + Mv)
    assert T * T == (Mv**2 - m**2) * identity_matrix(S, 4)
    Q = (T + k) * Wb.change_ring(S)
    I = S.ideal(Q.minors(Wb.ncols()) + [k**2 + m**2 - Mv**2])
    sols = I.variety(QQbar)
    return sorted({(QQ(sl[m]), QQ(sl[k])) for sl in sols
                   if sl[k].imag() == 0 and sl[m].imag() == 0 and sl[k] > 0})
for kap in (1, -1):
    for Mv in (1, -1):
        bL, bR = bound_states(kap, Mv, Lb), bound_states(kap, Mv, Rb)
        print("    kappa = %+d, M = %+d:  BC P_R psi(0)=0 -> %s ;  BC P_L psi(0)=0 -> %s"
              % (kap, Mv, bL, bR))
        if kap * Mv > 0:
            check(bL == [(0, 1)] and bR == [],
                  "kappa M > 0: P_R BC has EXACTLY one bound state, m = 0 (left zero mode); "
                  "P_L BC has none")
        else:
            check(bR == [(0, 1)] and bL == [],
                  "kappa M < 0: the mirror image (right zero mode under P_L BC)")
print("    (|m| = |M| is threshold, |m| > |M| oscillates: the continuum from |M|.)")
print("    (M scaled to +-1: the equations are homogeneous in (m, k, M).)")

# ============================================================ [D]
print("\n[D] Bulk mass profile M(y)")
yv, mu, cc = var('yv mu cc')
assume(mu > 0)
def norm_int(Mfun):
    return integral(exp(-2 * integral(Mfun, yv, 0, yv)), yv, 0, oo)
check(bool(limit(integral(exp(-2 * integral(SR(0), yv, 0, yv)), yv, 0, var('Ycut')), Ycut=oo) == oo),
      "M = 0: the zero-mode profile is constant, not normalisable -- the half-line "
      "alone does NOT give a localised mode")
check(bool(norm_int(mu) == 1 / (2 * mu)), "M = mu const > 0: normalisable (norm 1/(2 mu))")
check(bool(norm_int(mu * yv) == sqrt(pi) / (2 * sqrt(mu))),
      "M = mu y (grows with mass density): normalisable (Gaussian)")
forget(); assume(cc > QQ(1)/2)
check(bool(integral((1 + yv)**(-2 * cc), yv, 0, oo) == 1 / (2 * cc - 1)),
      "M = c/(1+y): normalisable iff c > 1/2 (here c > 1/2)")
forget(); Yc = var('Yc'); assume(Yc > 0)
check(all(bool(limit(integral((1 + yv)**(-2 * c0), yv, 0, Yc), Yc=oo) == oo)
          for c0 in (QQ(1)/4, QQ(1)/2)),
      "... and NOT for c = 1/4 or c = 1/2: a decaying M can lose the zero mode")
forget(); assume(mu > 0)
# M = mu y, kappa = +1: f_L' + M f_L = -m f_R ; f_R' - M f_R = m f_L (from [C]'s T)
fR = yv * exp(-mu * yv**2 / 2); mm = 2 * sqrt(mu)
fL = (diff(fR, yv) - mu * yv * fR) / mm
check(bool((diff(fL, yv) + mu * yv * fL + mm * fR).simplify_full() == 0) and fR.subs(yv=0) == 0,
      "M = mu y: a normalisable massive mode at m^2 = 4 mu with f_R(0) = 0 (the P_R BC)")
check(bool(limit(fL, yv=oo) == 0) and bool(limit(fR, yv=oo) == 0),
      "its profiles decay: for M ~ x^4 the partners form a DISCRETE tower "
      "m^2 = 4 mu n (SUSY-QM oscillator), not a continuum from |M|")

# ============================================================ [E]
print("\n[E] Williams' 8x8 (Eqs 109-111): two blocks")
beta = B(I2, Z2, Z2, -I2); alph = [B(Z2, si, si, Z2) for si in s]
Amat = B(Z2, i_ * I2, -i_ * I2, Z2); bT = B(beta, Z4, Z4, beta)
aT = [B(Z4, a, a, Z4) for a in alph] + [B(Amat, Z4, Z4, Amat)]
G8 = [bT] + [-bT * a for a in aT]                      # Williams Eq 111
check(clifford(G8), "8x8: 5D Clifford algebra")
I8 = identity_matrix(K, 8)
Gam = G8[0] * G8[1] * G8[2] * G8[3] * G8[4]
PA, PB = (I8 + Gam) / 2, (I8 - Gam) / 2
chi = i_ * G8[0] * G8[1] * G8[2] * G8[3]
QL, QR = (I8 - chi) / 2, (I8 + chi) / 2
b8 = G8[0] * G8[4]
Vp = ((I8 + i_ * G8[4]) / 2).column_space()            # zero-mode space, M > 0
sp = lambda P: P.column_space()
LA, LB, RA, RB = sp(QL * PA), sp(QL * PB), sp(QR * PA), sp(QR * PB)
check(all(V.dimension() == 2 for V in (LA, LB, RA, RB)), "L_A, L_B, R_A, R_B each 2-dim")
check(Vp.intersection(sp(QL)) == LA and Vp.intersection(sp(QR)) == RB,
      "zero modes: L in block A, R in block B (as su2_from_5d [D])")
Sig8 = [(G8[a] * G8[b] - G8[b] * G8[a]) / 4 for a in range(4) for b in range(a + 1, 4)]
Alg8 = algebra(Sig8)
check(Alg8.dimension() == 8 and vector(K, QL.list()) in Alg8,
      "Lorentz algebra on 8 dims: still M2 + M2, but L and R now have MULTIPLICITY 2")
# intertwiner L_A -> L_B and R_A -> R_B in the commutant of the Lorentz generators
In = I8
Mk = block_matrix([[X.transpose().tensor_product(In) - In.tensor_product(X)] for X in Sig8],
                  subdivide=False)
comm = [matrix(K, 8, 8, list(v)).transpose() for v in Mk.right_kernel().basis()]
check(len(comm) == 8, "commutant of Lorentz on 8 dims: dim 8 = M2(mult L) + M2(mult R)")
Tx = [PB * X * PA for X in comm if not (PB * X * PA * QL).is_zero()][0]
Ty = [PB * X * PA for X in comm if not (PB * X * PA * QR).is_zero()][0]
eLA = LA.basis_matrix().transpose(); eRA = RA.basis_matrix().transpose()
def VL(a): return a[0] * eLA + a[1] * (Tx * eLA)
def VR(b): return b[0] * eRA + b[1] * (Ty * eRA)
# cross form on multiplicity space: B(VL(e_i), VR(e_j)) = N_ij * beta0
E2 = identity_matrix(K, 2).columns()
blocks = [[H_(VL(E2[i])) * b8 * VR(E2[j]) for j in range(2)] for i in range(2)]
ref = [blk for row in blocks for blk in row if not blk.is_zero()][0]
pos = [(r, c) for r in range(2) for c in range(2) if ref[r, c] != 0][0]
Nm = matrix(K, 2, 2, lambda i, j: blocks[i][j][pos] / ref[pos])
check(all(blocks[i][j] == Nm[i, j] * ref for i in range(2) for j in range(2)),
      "the L-R part of the boundary form factorises: B = (a^dag N b) x beta0")
check(Nm.det() != 0, "N is non-degenerate")
def W(a, b):
    cols = []
    if a is not None: cols.append(VL(a))
    if b is not None: cols.append(VR(b))
    return block_matrix([cols], subdivide=False)
def selfadj(Wb): return H_(Wb) * b8 * Wb == 0 and perp(Wb, b8) == Wb.column_space()
check(selfadj(W(E2[0], None).augment(W(E2[1], None))) and selfadj(W(None, E2[0]).augment(W(None, E2[1]))),
      "block-pure members (2,0) and (0,2): all-L and all-R are self-adjoint")
a_gen = vector(K, [1, 1])
b_gen = (H_(matrix(K, [a_gen]).transpose()) * Nm).right_kernel().basis()[0]
Wmix = W(a_gen, b_gen)
check(selfadj(Wmix),
      "a MIXED member (a = (1,1), b with a^dag N b = 0) is Lorentz invariant and "
      "self-adjoint: in the 8x8, Lorentz + unitarity do NOT leave just two")
print("    => the (1,1) members form a CP^1 family (one line b for each line a).")
rel = PA - PB                                          # relative phase between blocks
inv = lambda Wb: (rel * Wb).column_space().is_subspace(Wb.column_space())
check(not inv(Wmix), "the mixed member breaks the blockwise phase symmetry of the 8x8")
Wp_ = W(E2[0], None).augment(W(None, E2[1]))           # L_A + R_B
Wm_ = W(E2[1], None).augment(W(None, E2[0]))           # L_B + R_A
check(Wp_.column_space() == Vp and selfadj(Wp_) and inv(Wp_),
      "L_A + R_B = V+ : self-adjoint and symmetric")
check(selfadj(Wm_) and inv(Wm_), "L_B + R_A = V- : self-adjoint and symmetric")
Wall_L = W(E2[0], None).augment(W(E2[1], None))
Wall_R = W(None, E2[0]).augment(W(None, E2[1]))
zm = lambda Wb: Wb.column_space().intersection(Vp).dimension() // 2
print("    zero-mode content (Weyl fields, M > 0):  V+ %d,  V- %d,  all-L %d,  all-R %d,  mixed %d"
      % (zm(Wp_), zm(Wm_), zm(Wall_L), zm(Wall_R), zm(Wmix)))
check((zm(Wp_), zm(Wm_), zm(Wall_L), zm(Wall_R), zm(Wmix)) == (2, 0, 1, 1, 0),
      "V+ keeps both (the doublet of su2_from_5d), V- none, all-L / all-R one, mixed none")
print("    su2_from_5d [D]: invariance under the native su(2) leaves only V+ and V-;")
print("    with the blockwise phases (checked here) the mixing family is excluded.")

print("\n" + "=" * 74)
print("""VERDICT
  1. Self-adjointness ([A]): deficiency indices are (2,2), and each 2-dim
     isotropic boundary subspace is maximal, so every member of the U(2)
     family -- in particular each chiral BC -- makes H SELF-ADJOINT, not
     only symmetric.  (von Neumann's extension theorem imported.)
  2. Exhaustive for one 4x4 irrep ([B]): the Lorentz generators generate
     M2 + M2 containing P_L, P_R; the invariant 2-planes are L and R only.
     The S1 classification is complete for an irreducible block.
  3. Spectrum ([C]): for constant M with kappa M > 0, BC P_R psi(0) = 0 has
     EXACTLY one normalisable bound state, the m = 0 left zero mode, and a
     continuum from |M|; BC P_L psi(0) = 0 has no bound state.
  4. Profile ([D]): the zero mode needs the bulk mass (M = 0 gives none);
     M = const and M ~ x^4 both work.  But for M ~ x^4 the massive partners
     are a DISCRETE tower m^2 = 4 mu n, not 'a continuum from |M|'.
  5. Williams' 8x8 ([E]): Lorentz + unitarity alone admit a CP^1 family of
     block-mixing BCs besides the block-pure ones.  The 8x8's own internal
     symmetry removes the mixing family; su(2) (su2_from_5d) leaves V+
     (both zero modes: the doublet) and V- (none).  So 'Lorentz invariance
     leaves two' is exact per irreducible block, and for the 8x8 it needs
     the internal symmetry as well.
  Bracket: local, linear BCs; M constant in [A]-[C]; the extension theorem
  and the Wedderburn structure are imported, the matrix facts computed.
""")
print("=" * 74)
print("ALL ASSERTIONS PASSED")
print("=" * 74)
